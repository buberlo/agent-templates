{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/agent-templates/template.schema.json",
  "title": "Agent Template Frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "domain",
    "category",
    "tags",
    "target_agents",
    "required_tools",
    "inputs",
    "outputs",
    "risk_level",
    "example_count",
    "version",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}[a-z0-9]$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "domain": {
      "type": "string",
      "enum": [
        "medien",
        "content-marketing",
        "vertrieb-crm",
        "kundenservice",
        "kommunikation",
        "office-dokumente",
        "recherche-wissen",
        "software-entwicklung",
        "devops-cloud",
        "it-betrieb-support",
        "security",
        "daten-analytics",
        "ki-ops",
        "automatisierung",
        "finanzen",
        "recht-verwaltung",
        "hr-recruiting",
        "projektmanagement",
        "bildung",
        "gesundheit-fitness",
        "reisen-events",
        "immobilien",
        "persoenlich-lifestyle",
        "gaming-modding",
        "hardware-embedded",
        "wissenschaft-engineering",
        "agent-platforms"
      ]
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,48}[a-z0-9]$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "target_agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "hermes",
          "grokbot",
          "openclaw",
          "claude-code",
          "codex",
          "cursor",
          "generic-mcp-agents",
          "generic"
        ]
      }
    },
    "required_tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "install", "version_notes"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "install": { "type": "string", "minLength": 1 },
          "version_notes": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "example_count": {
      "type": "integer",
      "minimum": 2,
      "maximum": 3
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updated": {
      "type": "string",
      "format": "date"
    }
  }
}